        ["cr854_description", "description", "text"],
        ["cr854_herokind", "hero_kind", "text"],
        ["cr854_sections", "sections", "text"]
      ],
      "lookups": []
    },
    "cr854_airequests": {
      "pg": "ai_requests",
      "pk": "cr854_airequestid",
      "columns": [
        ["cr854_name", "name", "text", {"required": true}],
