{
 "_comment": "CCP のデータ定義(唯一の正)。表・列の名前は、画面・API・PostgreSQL で同じ。ここから、表を作る SQL・API の許可リスト・値の変換を作る(server/ccp/schema.py)。列を足したら、画面の型(src/models、src/data)にも足す(scripts/check-schema.mjs が食い違いを見つける)。",
 "tables": {
  "delivery_cards": {
   "columns": [
    ["name", "text", {"required": true}],
    ["scheduled_at", "timestamptz"],
    ["country", "choice"],
    ["channel", "choice"],
    ["department", "choice"],
    ["status", "choice"],
    ["email_template", "choice"],
    ["layout_key", "text"],
    ["theme", "text"],
    ["theme_reason", "text"],
    ["headline", "text"],
    ["copy", "text"],
    ["copy_angle", "text"],
    ["instructions", "text"],
    ["instructions_angle", "text"],
    ["hero_reason", "text"],
    ["section_titles", "text"],
    ["section_copies", "text"],
    ["products", "text"],
    ["owner", "text"],
    ["production_due", "date"],
    ["links", "text"],
    ["production_owner", "text"],
    ["handed_off_at", "timestamptz"],
    ["push_link", "text"],
    ["audience", "text"],
    ["push_title", "text"],
    ["push_body", "text"],
    ["theme_type", "text"],
    ["cancelled_at", "timestamptz"],
    ["cancel_reason", "text"]
   ],
   "lookups": [
    ["hero_image_id", "hero_images", {"onDelete": "SET NULL"}]
   ]
  },
  "delivery_products": {
   "columns": [
    ["name", "text", {"required": true}],
    ["reason", "text"],
    ["section", "int"],
    ["sort_order", "int"],
    ["source", "choice"],
    ["state", "choice"]
   ],
   "lookups": [
    ["delivery_card_id", "delivery_cards", {"onDelete": "CASCADE"}],
    ["product_id", "products", {"onDelete": "SET NULL"}]
   ]
  },
  "products": {
   "columns": [
    ["name", "text", {"required": true}],
    ["product_code", "text", {"index": true}],
    ["category", "choice"],
    ["price", "numeric"],
    ["stock", "int"],
    ["season", "choice"],
    ["sales_trend", "choice"],
    ["rating", "numeric"],
    ["weather", "choice"],
    ["description", "text"],
    ["image_url", "text"],
    ["market", "choice"]
   ],
   "lookups": [
   ]
  },
  "hero_images": {
   "columns": [
    ["name", "text", {"required": true}],
    ["image_code", "text", {"index": true}],
    ["purpose", "choice"],
    ["season", "choice"],
    ["tags", "text"],
    ["description", "text"],
    ["image_url", "text"],
    ["market", "choice"]
   ],
   "lookups": [
   ]
  },
  "weekly_performances": {
   "columns": [
    ["name", "text", {"required": true}],
    ["product_code", "text", {"index": true}],
    ["week_start", "date"],
    ["units", "int"],
    ["revenue", "numeric"],
    ["stock", "int"]
   ],
   "lookups": [
   ]
  },
  "product_policies": {
   "columns": [
    ["name", "text", {"required": true}],
    ["product_code", "text", {"index": true}],
    ["policy", "text"],
    ["promo_plan", "text"],
    ["promo_period", "text"],
    ["stage", "text"]
   ],
   "lookups": [
   ]
  },
  "layout_templates": {
   "columns": [
    ["name", "text", {"required": true}],
    ["description", "text"],
    ["hero_kind", "text"],
    ["sections", "text"]
   ],
   "lookups": [
   ]
  },
  "ai_requests": {
   "columns": [
    ["name", "text", {"required": true}],
    ["prompt", "text"],
    ["response", "text"],
    ["status", "choice"]
   ],
   "lookups": [
   ]
  },
  "card_notes": {
   "columns": [
    ["kind", "text"],
    ["author", "text"],
    ["body", "text"],
    ["reply", "text"],
    ["replied_by", "text"],
    ["replied_at", "timestamptz"],
    ["resolved", "int"],
    ["assignee", "text"],
    ["due", "date"],
    ["source_note", "text"]
   ],
   "lookups": [
    ["delivery_card_id", "delivery_cards", {"onDelete": "CASCADE"}],
    ["product_id", "products", {"onDelete": "SET NULL"}]
   ]
  },
  "weeks": {
   "columns": [
    ["week_start", "date", {"index": true}],
    ["status", "text"],
    ["submitted_at", "timestamptz"],
    ["confirmed_at", "timestamptz"]
   ],
   "lookups": [
   ]
  },
  "delivery_results": {
   "columns": [
    ["sent_at", "timestamptz"],
    ["recipients", "int"],
    ["opens", "int"],
    ["clicks", "int"],
    ["orders", "int"],
    ["revenue", "numeric"],
    ["last_year_revenue", "numeric"],
    ["products", "text"],
    ["links", "text"],
    ["notes", "text"]
   ],
   "lookups": [
    ["delivery_card_id", "delivery_cards", {"onDelete": "CASCADE"}]
   ]
  },
  "events": {
   "columns": [
    ["action", "text"],
    ["week_start", "date", {"index": true}],
    ["card_name", "text"],
    ["from_status", "text"],
    ["to_status", "text"],
    ["actor", "text"],
    ["note", "text"]
   ],
   "lookups": [
    ["delivery_card_id", "delivery_cards", {"onDelete": "SET NULL"}]
   ]
  },
  "change_logs": {
   "columns": [
    ["kind", "text", {"index": true}],
    ["field", "text"],
    ["before_value", "text"],
    ["after_value", "text"],
    ["product_code", "text", {"index": true}],
    ["card_name", "text"],
    ["actor", "text"],
    ["resolved_at", "timestamptz"],
    ["resolved_by", "text"],
    ["resolve_note", "text"]
   ],
   "lookups": [
    ["delivery_card_id", "delivery_cards", {"onDelete": "SET NULL"}]
   ]
  }
 },
 "choices": {
  "delivery_cards.country": ["US", "JP"],
  "delivery_cards.channel": ["email", "app"],
  "delivery_cards.department": ["promotion", "crm", "ec"],
  "delivery_cards.email_template": ["free", "standard4", "collab", "offer", "cat2", "cat3"],
  "delivery_cards.status": ["not_started", "reviewing", "approved", "confirmed"],
  "delivery_products.source": ["ai", "manual"],
  "delivery_products.state": ["selected", "candidate"],
  "products.category": ["outer", "tops", "bottoms", "shoes", "accessories", "bags", "home"],
  "products.season": ["autumn", "winter", "autumn_winter", "all_year"],
  "products.sales_trend": ["up", "flat", "down"],
  "products.weather": ["sunny", "rainy", "cold"],
  "products.market": ["JP", "US"],
  "hero_images.purpose": ["new", "feature", "sale", "member", "event"],
  "hero_images.season": ["autumn", "winter", "autumn_winter", "all_year"],
  "hero_images.market": ["JP", "US"],
  "ai_requests.status": ["waiting", "done", "error"],
  "events.from_status": ["not_started", "reviewing", "approved", "confirmed"],
  "events.to_status": ["not_started", "reviewing", "approved", "confirmed"]
 }
}
