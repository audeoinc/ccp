        ["cr854_opens", "opens", "int"],
        ["cr854_clicks", "clicks", "int"],
        ["cr854_orders", "orders", "int"],
        ["cr854_revenue", "revenue", "numeric"],
        ["cr854_lastyearrevenue", "last_year_revenue", "numeric"],
        ["cr854_products", "products", "text"],
        ["cr854_notes", "notes", "text"]
      ],
      "lookups": [
        ["cr854_deliverycard", "delivery_card_id", "cr854_deliverycards", {"onDelete": "CASCADE"}]
      ]
    }
