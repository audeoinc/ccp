        ["cr854_sortorder", "sort_order", "int"],
        ["cr854_source", "source", "choice"],
        ["cr854_state", "state", "choice"]
      ],
      "lookups": [
        ["cr854_deliverycard", "delivery_card_id", "cr854_deliverycards", {"onDelete": "CASCADE"}],
        ["cr854_product", "product_id", "cr854_products", {"onDelete": "SET NULL"}]
      ]
    },
    "cr854_products": {
      "pg": "products",
      "pk": "cr854_productid",
      "columns": [
        ["cr854_name", "name", "text", {"required": true}],
        ["cr854_productcode", "product_code", "text", {"index": true}],
        ["cr854_category", "category", "choice"],
        ["cr854_price", "price", "numeric"],
        ["cr854_stock", "stock", "int"],
        ["cr854_season", "season", "choice"],
        ["cr854_salestrend", "sales_trend", "choice"],
        ["cr854_rating", "rating", "numeric"],
        ["cr854_weather", "weather", "choice"],
        ["cr854_description", "description", "text"],
        ["cr854_imageurl", "image_url", "text"],
        ["cr854_market", "market", "choice"]
