{
  "_comment": "CCP のデータ定義(唯一の正)。Dataverse の論理名(画面が使う名前)と、PostgreSQL の読みやすい名前の対応表。ここから、テーブルを作る SQL、API の名前変換、触ってよいテーブル・列の許可リストを作る。列を足したら、ここにも書く(scripts/check-schema.mjs が、src/generated/models との食い違いを検出する)。type: text / int / numeric / timestamptz / date / choice(選択肢の数値)。lookups: 他のテーブルへの参照(画面では _<名前>_value で読み、<名前>@odata.bind で書く)。",
  "tables": {
    "cr854_deliverycards": {
      "pg": "delivery_cards",
      "pk": "cr854_deliverycardid",
      "columns": [
        ["cr854_name", "name", "text", {"required": true}],
        ["cr854_scheduledat", "scheduled_at", "timestamptz"],
        ["cr854_country", "country", "choice"],
        ["cr854_channel", "channel", "choice"],
        ["cr854_department", "department", "choice"],
        ["cr854_status", "status", "choice"],
        ["cr854_emailtemplate", "email_template", "choice"],
        ["cr854_layoutkey", "layout_key", "text"],
        ["cr854_theme", "theme", "text"],
        ["cr854_themereason", "theme_reason", "text"],
        ["cr854_headline", "headline", "text"],
        ["cr854_copy", "copy", "text"],
        ["cr854_copyangle", "copy_angle", "text"],
        ["cr854_instructions", "instructions", "text"],
        ["cr854_instructionsangle", "instructions_angle", "text"],
        ["cr854_heroreason", "hero_reason", "text"],
        ["cr854_sectiontitles", "section_titles", "text"],
        ["cr854_sectioncopies", "section_copies", "text"],
        ["cr854_products", "products", "text"],
        ["cr854_owner", "owner", "text", {"gcpOnly": true}],
        ["cr854_productiondue", "production_due", "date", {"gcpOnly": true}],
        ["cr854_links", "links", "text", {"gcpOnly": true}],
        ["cr854_productionowner", "production_owner", "text", {"gcpOnly": true}],
        ["cr854_handedoffat", "handed_off_at", "timestamptz", {"gcpOnly": true}],
        ["cr854_pushlink", "push_link", "text", {"gcpOnly": true}],
        ["cr854_audience", "audience", "text", {"gcpOnly": true}],
        ["cr854_pushtitle", "push_title", "text", {"gcpOnly": true}],
        ["cr854_pushbody", "push_body", "text", {"gcpOnly": true}]
      ],
      "lookups": [
        ["cr854_heroimage", "hero_image_id", "cr854_heroimages", {"onDelete": "SET NULL"}]
      ]
    },
    "cr854_deliveryproducts": {
      "pg": "delivery_products",
      "pk": "cr854_deliveryproductid",
      "columns": [
        ["cr854_name", "name", "text", {"required": true}],
        ["cr854_reason", "reason", "text"],
