# Vertex AI Workbench で CCP を動かすときの設定の見本(手順は docs/WORKBENCH.md)。
# このファイルを workbench.env という名前でコピーし、<…> を、その環境の値に書き換える。
# workbench.env はパスワードを含むので、Git には入れない(.gitignore 済み)。
#   cp workbench.env.example workbench.env
# 読み込み方(サーバーを起動するターミナルで、毎回):
#   set -a; source workbench.env; set +a

# ---- DB: PostgreSQL に直接つなぐ(Workbench の上や、同じネットワークのサーバーで動いている PostgreSQL)
#    書き方: postgresql+asyncpg://<ユーザー>:<パスワード>@<ホスト>:<ポート>/<DB の名前>
#    (パスワードに @ : / # などの記号があるときは、URL の形に置き換える。例: @ → %40)
#    値は '…' で囲む($ や & などの記号を、シェルが別の意味に読まないように)
DATABASE_URL='postgresql+asyncpg://<ユーザー>:<パスワード>@<ホスト>:5432/<DB の名前>'
#    PostgreSQL が Workbench の中(ホストが localhost)なら、scripts/workbench.sh の start・update・restart が、
#    止まっているときに自動で起動する。データのフォルダ(PG_VERSION があるフォルダ)と、pg_ctl の場所を書いておくと確実
#    (書かなければ、ホームの下と conda の環境から探す)
# CCP_PGDATA=<PostgreSQL のデータのフォルダ>
# CCP_PG_BIN=<pg_ctl のあるフォルダ。例: /home/jupyter/miniconda3/envs/pg/bin>

# ---- ポート(scripts/workbench.sh で起動するとき。既定は 8082。画面は …/proxy/<ポート>/)
#    前から 8081 で動かしている Workbench は、ここで 8081 にすると、URL を変えずに使い続けられる
# CCP_PORT=8082

# ---- AI(Vertex AI の Gemini)。Workbench のサービスアカウントに「Vertex AI ユーザー」の権限が要る
GOOGLE_CLOUD_PROJECT=<プロジェクトID>
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=low

# ---- BigQuery(利用先の本番のデータ。docs/BIGQUERY.md・docs/BIGQUERY_EXPORT.md)。使わないなら、すべて # のまま
#    サービスアカウントに「BigQuery データ閲覧者」「BigQuery ジョブユーザー」の権限が要る。確かめ方: .venv/bin/python -m ccp.cli check
#    場所は <プロジェクト>.<データセット>.<テーブルかビュー>。ビューなら、更新を見る元のテーブルを _WATCH に書く
# BQ_PROJECT=<問い合わせを走らせるプロジェクト。なければ GOOGLE_CLOUD_PROJECT>
# BQ_SPU=<プロジェクト>.<データセット>.<SPU の出力>
# BQ_SKU=<プロジェクト>.<データセット>.<SKU の出力>
# BQ_SKU_STOCK=<プロジェクト>.<データセット>.<SKU の在庫の出力>
# BQ_SKU_STOCK_WATCH=<在庫の出力がビューのとき、元の在庫のテーブル>
# BQ_WEEKLY=<プロジェクト>.<データセット>.<週ごとの実績の出力>
# BQ_FORECAST=<プロジェクト>.<データセット>.<天気予報の出力>
# BQ_RANKING=<プロジェクト>.<データセット>.<販売チャネルごとの順位の出力>(結果の画面で使う。BIGQUERY_EXPORT.md の 9 章)
#    鍵ファイルで接続しているときだけ: GOOGLE_APPLICATION_CREDENTIALS=<鍵ファイルの絶対パス>

# ---- 開発用の画面(/dev/。docs/DEVTOOLS.md)。BigQuery の出力の SQL・ポリシーの文書を、Gemini と作る。使うときだけ 1 にする
#    開くのは https://<ノートブックの URL>/proxy/8082/dev/(末尾の / が要る)。BigQuery は読むだけ(SELECT だけを流す)
# CCP_DEVTOOLS=1
# DEVTOOLS_MAX_GB=10(1 回の問い合わせで読む量の上限。超えると BigQuery が止める)

# ---- 画像: 引っ越し用のパックから展開したフォルダ(import-pack の既定は server/images)
ASSET_DIR=<server フォルダの絶対パス>/images

# ---- 画面のパスワード(Basic 認証)。Workbench の中継は Google のログインで守られているので、空のままでもよい
# APP_PASSWORD=<任意のパスワード>
