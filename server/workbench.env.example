# Vertex AI Workbench で CCP を動かすときの設定の見本(手順は docs/WORKBENCH.md)。
# このファイルを workbench.env という名前でコピーし、<…> を、その環境の値に書き換える。
# workbench.env はパスワードを含むので、Git には入れない(.gitignore 済み)。
#   cp workbench.env.example workbench.env
# 読み込み方(サーバーを起動するターミナルで、毎回):
#   set -a; source workbench.env; set +a

# ---- DB(どちらか一方)
# A. PostgreSQL に直接つなぐ(Workbench の上や、同じネットワークのサーバーで動いている PostgreSQL)。クライアントの環境は、こちら
#    書き方: postgresql+asyncpg://<ユーザー>:<パスワード>@<ホスト>:<ポート>/<DB の名前>
#    (パスワードに @ : / # などの記号があるときは、URL の形に置き換える。例: @ → %40)
#    値は '…' で囲む($ や & などの記号を、シェルが別の意味に読まないように)
DATABASE_URL='postgresql+asyncpg://<ユーザー>:<パスワード>@<ホスト>:5432/<DB の名前>'
# B. Cloud SQL につなぐ(A の 1 行を消すか、先頭に # を付ける)。Workbench のサービスアカウントに「Cloud SQL クライアント」の権限が要る
# CLOUD_SQL_INSTANCE=<プロジェクトID>:<リージョン>:<インスタンス名>
# DB_USER=<DB のユーザー名>
# DB_PASSWORD=<DB のパスワード>
# DB_NAME=<DB の名前>

# ---- AI(Vertex AI の Gemini)。Workbench のサービスアカウントに「Vertex AI ユーザー」の権限が要る
GOOGLE_CLOUD_PROJECT=<プロジェクトID>
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=low

# ---- 画像: 引っ越し用のパックから展開したフォルダ(import-pack の既定は server/images)
ASSET_DIR=<server フォルダの絶対パス>/images

# ---- 画面のパスワード(Basic 認証)。Workbench の中継は Google のログインで守られているので、空のままでもよい
# APP_PASSWORD=<任意のパスワード>

# 次の設定は、Workbench では使わない(Cloud Run の本番だけ): DB_CONTROL、STATE_BUCKET、CCP_DEV_GCLOUD、IDLE_CHECK_*
