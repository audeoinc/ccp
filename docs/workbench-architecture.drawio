<mxfile host="app.diagrams.net"><diagram id="ccp-workbench" name="Workbench の構成"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="browser" value="&lt;b&gt;利用者のブラウザ&lt;/b&gt;&lt;br&gt;https://&lt;ノートブックの URL&gt;/proxy/8081/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="230" height="80" as="geometry"/></mxCell><mxCell id="github" value="&lt;b&gt;GitHub のリポジトリ&lt;/b&gt;&lt;br&gt;(コード)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="230" height="70" as="geometry"/></mxCell><mxCell id="vertex" value="&lt;b&gt;Vertex AI&lt;/b&gt;&lt;br&gt;(Gemini)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1390" y="300" width="170" height="80" as="geometry"/></mxCell><mxCell id="wb" value="Vertex AI Workbench のインスタンス" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="320" y="20" width="1000" height="700" as="geometry"/></mxCell><mxCell id="proxy" value="&lt;b&gt;Jupyter の中継&lt;/b&gt;&lt;br&gt;/proxy/8081/&lt;br&gt;(Google のログインで守られる)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="220" height="100" as="geometry"/></mxCell><mxCell id="jupyter" value="&lt;b&gt;Jupyter の画面&lt;/b&gt;&lt;br&gt;(ファイルのアップロード・ターミナル)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="220" height="70" as="geometry"/></mxCell><mxCell id="pack" value="&lt;b&gt;引っ越し用のパック(ZIP)&lt;/b&gt;&lt;br&gt;data.json + images/" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="240" height="70" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;CCP のサーバー&lt;/b&gt;&lt;br&gt;Python / FastAPI(uvicorn)&lt;br&gt;localhost:8081&lt;br&gt;・画面(dist-gcp/)を配る&lt;br&gt;・/api/data データ&lt;br&gt;・/img 画像&lt;br&gt;・/api/ask AI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="250" width="260" height="180" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;(conda)&lt;br&gt;localhost:5432" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="230" width="170" height="110" as="geometry"/></mxCell><mxCell id="images" value="&lt;b&gt;画像のフォルダ&lt;/b&gt;&lt;br&gt;server/images/(ASSET_DIR)" style="shape=folder;tabWidth=60;tabHeight=14;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="200" height="70" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;設定&lt;/b&gt;&lt;br&gt;server/workbench.env&lt;br&gt;(DB の接続先・AI の設定。Git に入れない)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="260" height="80" as="geometry"/></mxCell><mxCell id="script" value="&lt;b&gt;操作のスクリプト&lt;/b&gt;&lt;br&gt;scripts/workbench.sh&lt;br&gt;start / stop / update / import / status / pg-start / check / log&lt;br&gt;(起動の前に、PostgreSQL が止まっていれば起動する)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="490" width="230" height="140" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;リポジトリ(~/ccp)&lt;/b&gt;&lt;br&gt;画面・サーバーのコード" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="560" width="260" height="70" as="geometry"/></mxCell><mxCell id="e1" value="画面を開く" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="中継" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proxy" target="server"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="データの読み書き" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="server" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="画像を読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="server" target="images"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="AI の依頼&lt;br&gt;(サービスアカウント)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="server" target="vertex"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="パック(ZIP)をアップロード" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="jupyter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="置く" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jupyter" target="pack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="import で取り込む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pack" target="script"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="起動・停止" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="script" target="server"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="読み込む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=au