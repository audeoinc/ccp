<mxfile host="app.diagrams.net"><diagram id="ccp-workbench" name="Workbench での構成"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="browser" value="&lt;b&gt;利用者のブラウザ&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="300" height="470" as="geometry"/></mxCell><mxCell id="page" value="&lt;b&gt;画面(HTML・JS)&lt;/b&gt;&lt;br&gt;サーバーから受け取り、表示する" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=13;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="240" height="90" as="geometry"/></mxCell><mxCell id="js" value="&lt;b&gt;JS(React)&lt;/b&gt;&lt;br&gt;画面の操作に応じて、サーバーの API を呼ぶ(fetch)。返ってきた JSON で、画面を書き換える" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=13;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="240" height="150" as="geometry"/></mxCell><mxCell id="wb" value="&lt;b&gt;Vertex AI Workbench のインスタンス&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="380" y="30" width="1190" height="690" as="geometry"/></mxCell><mxCell id="proxy" value="&lt;b&gt;Jupyter の中継&lt;/b&gt;&lt;br&gt;ブラウザからの通信を、インスタンスの中の localhost:8082 に中継する(Google のログインで守られる)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=13;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="410" y="250" width="200" height="170" as="geometry"/></mxCell><mxCell id="uvicorn" value="&lt;b&gt;uvicorn(Web サーバー)&lt;/b&gt;&lt;br&gt;localhost:8082 で HTTP を待ち受け、届いた依頼を FastAPI に渡す。返事を送り返す" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="470" height="610" as="geometry"/></mxCell><mxCell id="fastapi" value="&lt;b&gt;FastAPI(アプリの本体。Python)&lt;/b&gt;&lt;br&gt;URL ごとに、処理を振り分ける" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="690" y="190" width="410" height="480" as="geometry"/></mxCell><mxCell id="r_page" value="&lt;b&gt;/(画面)&lt;/b&gt;&lt;br&gt;画面の HTML・JS を返す" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="715" y="270" width="360" height="70" as="geometry"/></mxCell><mxCell id="r_data" value="&lt;b&gt;/api/data&lt;/b&gt;&lt;br&gt;データの読み書き。結果を JSON で返す" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="715" y="365" width="360" height="70" as="geometry"/></mxCell><mxCell id="r_img" value="&lt;b&gt;/img&lt;/b&gt;&lt;br&gt;商品・メイン画像を返す" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="715" y="460" width="360" height="70" as="geometry"/></mxCell><mxCell id="r_ask" value="&lt;b&gt;/api/ask&lt;/b&gt;&lt;br&gt;AI に依頼し、返答を JSON で返す" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=12;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="715" y="555" width="360" height="70" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL(データベース)&lt;/b&gt;&lt;br&gt;データを保存・検索する&lt;br&gt;(配信・商品・結果・メモ・履歴 など)&lt;br&gt;localhost:5432" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1210" y="330" width="320" height="150" as="geometry"/></mxCell><mxCell id="images" value="&lt;b&gt;画像のフォルダ&lt;/b&gt;&lt;br&gt;server/images/" style="shape=folder;tabWidth=60;tabHeight=14;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1250" y="510" width="240" height="80" as="geometry"/></mxCell><mxCell id="vertex" value="&lt;b&gt;Vertex AI(Gemini)&lt;/b&gt;&lt;br&gt;文案・選定・振り返りを作る" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=13;verticalAlign=middle;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1630" y="545" width="220" height="100" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;1 回の操作の流れ&lt;/b&gt;&lt;br&gt;① ブラウザが画面(HTML・JS)を読み込む&lt;br&gt;② 画面を操作すると、JS がサーバーの API を呼ぶ(例: /api/data)&lt;br&gt;③ Jupyter の中継が、uvicorn に届ける&lt;br&gt;④ uvicorn が FastAPI に渡し、FastAPI が URL に合う処理を動かす&lt;br&gt;⑤ FastAPI が PostgreSQL に SQL で読み書きする(AI のときは Vertex AI に依頼する)&lt;br&gt;⑥ 結果を JSON で返し、JS が画面を書き換える" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=13;verticalAlign=top;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="900" height="190" as="geometry"/></mxCell><mxCell id="e1" value="① 画面を読み込む&lt;br&gt;HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="page" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="② API を呼ぶ&lt;br&gt;HTTPS・JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="js" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="③ HTTP&lt;br&gt;(インスタンスの中)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="1" source="proxy" target="uvicorn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="⑤ SQL&lt;br&gt;(読み書き)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_data" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="ファイルを読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_img" target="images"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="HTTPS・JSON&lt;br&gt;(サービスアカウントの権限)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.5;fontSize=12;fontColor=#1e293b;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_ask" target="vertex"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
